# CẤU HÌNH THIẾT BỊ PHẦN CỨNG (True: Sử dụng GPU CUDA nếu khả dụng, False: Chạy CPU)
USE_GPU=True

# NGUỒN VIDEO CAMERA RTSP (HOẶC 0 CHO WEBCAM / ĐƯỜNG DẪN TỆP VIDEO MP4)
DEFAULT_CAMERA_SOURCE=rtsp://username:password@ip_address:port/stream

# CẤU HÌNH MÁY CHỦ WEB BACKEND FASTAPI
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
